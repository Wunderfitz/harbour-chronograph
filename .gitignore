# Builds belong out of tree: Qt Creator shadow-builds by default, and sfdk does
# too when it is given a path to the sources ("sfdk build <srcdir>"). Apart from
# the lupdate template further down, nothing listed here should turn up in a
# checkout at all - the rest is a safety net for in-tree builds.

# Qt Creator's per-user project settings
*.pro.user*

# a build directory put inside the checkout rather than beside it
/build*/

# qmake / make
Makefile
.qmake.stash
*.o
moc_*
qrc_*
/harbour-chronograph

# lupdate rewrites the source-language template on every install; only the
# translated catalogues are tracked
translations/harbour-chronograph.ts
translations/*.qm

# rpmbuild
/RPMS/
/.sfdk/
/*.list

# Personal data, never committed: the phone recordings of real walks and
# everything that describes them stay on the machine they were made for (see
# CLAUDE.md). The tests that are committed use synthetic signals only.
/tests/raw-data/
# a recording copied off the phone anywhere else in the checkout
recording-*.csv
